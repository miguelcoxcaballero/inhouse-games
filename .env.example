# Deployment: HTTPS termination is required outside localhost.
HOST=127.0.0.1
PORT=8080
# Google authentication is required by default. This public OAuth client is
# the same one used by Inhouse Notes and Read; it is not a secret.
# GOOGLE_CLIENT_ID=435784295430-cmug30o42f1vu4ijgor9sjb0ro4oo37o.apps.googleusercontent.com
# Optionally restrict a personal deployment to comma-separated verified emails.
# GOOGLE_ALLOWED_EMAILS=owner@example.com
# Persist hashes of 30-day application sessions outside public/static files.
# INHOUSE_SESSION_FILE=/var/lib/inhouse-link/account-sessions.json
# Additional shared service access key (optional with Google authentication).
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Enter it in each client's masked "Clave del servicio" setting. Never commit it.
# SERVICE_TOKEN=
# Comma-separated exact web origins, no trailing slash.
# ALLOWED_ORIGINS=https://miguelcoxcaballero.github.io
# Set only when behind your own trusted reverse proxy.
# TRUST_PROXY=1
# Optional ICE servers for NAT traversal; provide your own infrastructure.
# STUN_URLS=stun:turn.inhouse.example:3478
# TURN_URLS=turn:turn.inhouse.example:3478?transport=udp,turns:turn.inhouse.example:5349?transport=tcp
# TURN_SECRET is a server-only coturn shared secret. Never send it to the renderer.
# TURN_SECRET=
# Alternative static TURN credentials (prefer short-lived TURN_SECRET credentials).
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Frontend build configuration. Neither value may contain credentials.
# VITE_BASE_PATH=/inhouse-games/
# VITE_SIGNALING_URL=https://link.inhouse.example
