{
  "name": "inhouse-link",
  "version": "0.2.0",
  "private": true,
  "description": "Inhouse Link — streaming remoto propio para web y Windows",
  "author": "Inhouse",
  "license": "UNLICENSED",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node server/index.mjs",
    "desktop": "node scripts/desktop.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs desktop/*.test.cjs",
    "test:e2e": "playwright test",
    "build:windows": "npm run build && electron-builder --win portable --x64 --publish never && node scripts/stage-windows.mjs",
    "build:windows:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "check": "npm run typecheck && npm test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "software.inhouse.link",
    "productName": "Inhouse Link",
    "executableName": "InhouseLink",
    "asar": true,
    "electronLanguages": ["es", "en-US"],
    "compression": "maximum",
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "dist/**/*",
      "!dist/downloads/**/*",
      "server/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "desktop/native/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Inhouse-Link-Windows.exe",
      "icon": "desktop/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
